{
  "manifest_version": 3,
  "name": "Gemini Usage Tracker",
  "version": "1.3",
  "description": "Token usage tracker for Gemini with on-hover pill button and one-click sync.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "icons": {
    "128": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_idle"
    }
  ]
}