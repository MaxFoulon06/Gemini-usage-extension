{
  "manifest_version": 3,
  "name": "AI Usage Tracker (Gemini, ChatGPT, Claude)",
  "version": "2.0",
  "description": "Real-time usage limit tracker for Gemini, ChatGPT, and Claude with morphing pill UI.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "icons": {
    "128": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*",
        "https://chatgpt.com/*",
        "https://claude.ai/*"
      ],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_idle"
    }
  ]
}